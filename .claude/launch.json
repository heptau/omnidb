{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8765", "--directory", "docs/en"],
      "port": 8765
    },
    {
      "name": "omnidb-web",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd OmniDB && ../venv/bin/python3 manage.py runserver 8001"],
      "port": 8001
    },
    {
      "name": "omnidb-go-server",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd go-server && OMNIDB_PROXY_UPSTREAM=http://127.0.0.1:8001 OMNIDB_PROXY_LISTEN_PORT=8002 go run ."],
      "port": 8002
    }
  ]
}
